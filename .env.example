API_PORT=3001
JWT_SECRET=change-this-to-a-long-random-secret
DATABASE_URL=postgresql://ml_store_user:change-this-password@127.0.0.1:5432/ml_store
PG_POOL_MAX=10
TRUST_PROXY_HOPS=0

